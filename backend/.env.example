# ============================================================================
# CircularFlow AI — Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows PowerShell)
#
# NEVER commit .env to Git.  It is listed in .gitignore.
# ============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info

# ── PostgreSQL Database (REQUIRED) ───────────────────────────────────────────
#
# Phase 13 requires a real hosted PostgreSQL database.
# SQLite is NOT supported.
#
# Format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Hosted provider examples (free tiers available):
#   Neon:         postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase:     postgresql://postgres:pass@db.projectid.supabase.co:5432/postgres
#   Railway:      postgresql://postgres:pass@containers-us-west.railway.app:5432/railway
#   ElephantSQL:  postgresql://user:pass@loph.db.elephantsql.com/dbname
#   Local:        postgresql://postgres:password@localhost:5432/circularflow
#
# IMPORTANT:
#   - Do NOT use sqlite:// here
#   - Do NOT put real credentials in this .env.example file
#   - Copy this file to .env and fill in your real values there
#
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE
 
# ── Phase 15: LLM Integration with RAG ───────────────────────────────────────
# LLM Provider Configuration (OpenAI-compatible API)
# NEVER put real API keys into .env.example or commit them to Git.
#
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1


# ── Phase 20: Email Notification System ──────────────────────────────────────
# Provider: Resend (https://resend.com — free tier: 3,000 emails/month)
# Obtain your key at: https://resend.com/api-keys
#
# If EMAIL_PROVIDER_API_KEY is set, Resend is used (recommended).
# If only SMTP_HOST is set, Python smtplib fallback is used (Gmail, Outlook, etc.)
# If neither is set, emails are silently skipped — the app works without email.
#
# NEVER commit real credentials to Git.
#
EMAIL_ENABLED=true
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@vignan.ac.in
EMAIL_FROM_NAME=CircularFlow AI — Vignan's University

# SMTP fallback (only used if EMAIL_PROVIDER_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
